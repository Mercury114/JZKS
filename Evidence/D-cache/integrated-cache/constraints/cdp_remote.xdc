# Cache版本 CDP 远程板约束；来源la-course-design@6de28bf，原引脚不变。
# 引脚逐项来自 cdp_ede_remote@3f68938056562c751a460da1d6e51094437c9736。
# 只保留实际使用的时钟、BTN6、拨码、LED 与数码管，原始完整约束另行保留。
set_property -dict {PACKAGE_PIN K21 IOSTANDARD LVCMOS33} [get_ports clk_50M] ;#50MHz main clock in
set_property -dict {PACKAGE_PIN U5 IOSTANDARD LVCMOS33} [get_ports reset_btn] ;#BTN6
set_property -dict {PACKAGE_PIN B24 IOSTANDARD LVCMOS33} [get_ports {leds[0]}]
